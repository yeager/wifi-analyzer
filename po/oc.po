#: src/wifi_analyzer/app.py:173
msgid "Unavailable in the detected regulatory domain"
msgstr "Indisponible dins lo domeni reglamentari detectat"

#: src/wifi_analyzer/app.py:175
msgid "DFS — radar detection may interrupt this channel"
msgstr "DFS — la deteccion de radar pòt interrompre aqueste canal"

#: src/wifi_analyzer/app.py:177
msgid "DFS — availability depends on local regulations"
msgstr "DFS — disponibilitat segon la reglamentacion locala"

#: src/wifi_analyzer/app.py:258 src/wifi_analyzer/app.py:400
msgid "No Wi-Fi device found"
msgstr "Cap de periferic Wi-Fi pas trobat"

#: src/wifi_analyzer/app.py:259
msgid ""
"Enable Wi-Fi in system settings, disable airplane mode, and check the "
"adapter driver."
msgstr ""
"Activatz la connexion Wi-Fi dins los paramètres sistèma, desactivatz lo mòde "
"avion e verificatz lo pilòt de l’adaptador."

#: src/wifi_analyzer/app.py:262
msgid "Wi-Fi signal is weak"
msgstr "Lo senhal Wi-Fi es feble"

#: src/wifi_analyzer/app.py:263
msgid ""
"Move closer to the access point, reduce obstructions, or select a less "
"congested channel."
msgstr ""
"Desplaçatz-vos mai prèp del ponch d’accès, redusissètz las obstruccions o "
"seleccionatz un canal mens saturat."

#: src/wifi_analyzer/app.py:266
msgid "Wi-Fi connection was lost"
msgstr "La connexion Wi-Fi es estada perduda"

#: src/wifi_analyzer/app.py:267
msgid ""
"Check the access point, reconnect from system settings, and inspect the "
"gateway and DNS diagnostics."
msgstr ""
"Verificatz lo ponch d’accès, reconnectatz-vos a partir dels paramètres "
"sistèma e examinar la palanca e los diagnostics DNS."

#: src/wifi_analyzer/app.py:269
msgid "Wi-Fi access point changed"
msgstr "Ponch d’accès Wi-Fi modificat"

#: src/wifi_analyzer/app.py:270
msgid ""
"Roaming can be normal. If it causes interruptions, compare signal history "
"and access-point overlap."
msgstr ""
"L’itinerància pòt èsser normala. Se causa d’interrupcions, comparatz "
"l’istoric de senhal e la superposicion de ponches d’accès."

#: src/wifi_analyzer/app.py:398
msgid "Error: no WiFi device found"
msgstr "Error : cap de periferic Wi-Fi pas trobat"

#: src/wifi_analyzer/app.py:439 src/wifi_analyzer/app.py:1015
#: src/wifi_analyzer/app.py:1104
msgid "<Hidden>"
msgstr "<Amagat>"

