msgid "Export diagnostic report"
msgstr "Exportera diagnostikrapport"

#: src/wifi_analyzer/app.py:851 src/wifi_analyzer/app.py:1192
msgid "Connection diagnostics"
msgstr "Anslutningsdiagnostik"

#: src/wifi_analyzer/app.py:852
msgid "Clear local history"
msgstr "Rensa lokal historik"

#: src/wifi_analyzer/app.py:853
msgid "About"
msgstr "Om"

#: src/wifi_analyzer/app.py:857
msgid "Scan"
msgstr "Skanna"

#: src/wifi_analyzer/app.py:860
msgid "Monitor"
msgstr "Övervaka"

#: src/wifi_analyzer/app.py:860
msgid "Scan every 60 seconds and notify about changes"
msgstr "Skanna var 60:e sekund och meddela när nätverken ändras"

#: src/wifi_analyzer/app.py:895
msgid "Filter by name, BSSID, channel or security"
msgstr "Filtrera efter namn, BSSID, kanal eller säkerhetstyp"

#: src/wifi_analyzer/app.py:904
msgid "Minimum signal"
msgstr "Minsta signalstyrka"

#: src/wifi_analyzer/app.py:908
msgid "Only show access points at or above this estimated dBm value"
msgstr ""
"Visa bara åtkomstpunkter med minst den här uppskattade signalstyrkan (dBm)"

#: src/wifi_analyzer/app.py:912 src/wifi_analyzer/app.py:925
#: src/wifi_analyzer/app.py:1109
msgid "Security"
msgstr "Säkerhet"

#: src/wifi_analyzer/app.py:915 src/wifi_analyzer/app.py:1101
msgid "All security"
msgstr "Alla säkerhetstyper"

#: src/wifi_analyzer/app.py:920
msgid "Hidden SSIDs only"
msgstr "Endast dolda SSID:er"

#: src/wifi_analyzer/app.py:924
msgid "Sort"
msgstr "Sortera"

#: src/wifi_analyzer/app.py:925
msgid "Signal"
msgstr "Signal"

#: src/wifi_analyzer/app.py:925 src/wifi_analyzer/app.py:1107
msgid "Channel"
msgstr "Kanal"

#: src/wifi_analyzer/app.py:928
msgid "Profile"
msgstr "Profil"

#: src/wifi_analyzer/app.py:930
msgid "Keep local scan history separate for this location"
msgstr "Spara separat skanningshistorik för den här profilen"

#: src/wifi_analyzer/app.py:959
msgid "Ready — click Scan"
msgstr "Redo — välj Skanna"

#: src/wifi_analyzer/app.py:1003
#, python-brace-format
msgid "Main overlapping access points: {names}"
msgstr "Åtkomstpunkter med störst överlappning: {names}"

#: src/wifi_analyzer/app.py:1005
msgid "No overlapping access points detected"
msgstr "Inga överlappande åtkomstpunkter hittades"

#: src/wifi_analyzer/app.py:1012
msgid "Signal history"
msgstr "Signalhistorik"

#: src/wifi_analyzer/app.py:1016
#, python-brace-format
msgid "Local history for profile: {profile}"
msgstr "Lokal historik för profil: {profile}"

#: src/wifi_analyzer/app.py:1025
msgid "Scanning..."
msgstr "Skannar..."

#: src/wifi_analyzer/app.py:1039
msgid "Monitoring enabled; scanning every 60 seconds"
msgstr "Övervakning aktiverad; söker av var 60:e sekund"

#: src/wifi_analyzer/app.py:1043
msgid "Monitoring disabled"
msgstr "Övervakning inaktiverad"

#: src/wifi_analyzer/app.py:1064
#, python-brace-format
msgid " · {new} new, {gone} gone"
msgstr " · nya: {new}, försvunna: {gone}"

#: src/wifi_analyzer/app.py:1068
#, python-brace-format
msgid "Scan failed: {error}"
msgstr "Skanningen misslyckades: {error}"

#: src/wifi_analyzer/app.py:282
msgid "Wi-Fi scan failed"
msgstr "Det gick inte att söka efter Wi-Fi-nätverk"

#: src/wifi_analyzer/app.py:284
msgid "Check that NetworkManager is running and your Wi-Fi adapter is enabled. For Flatpak, make sure the app can access NetworkManager."
msgstr "Kontrollera att NetworkManager är igång och att wifi-adaptern är på. I Flatpak måste appen få ansluta till NetworkManager."

#: src/wifi_analyzer/app.py:1070
#, python-brace-format
msgid "Found {count} networks{suffix}"
msgstr "Hittade {count} nätverk{suffix}"

#: src/wifi_analyzer/app.py:1072
msgid "WiFi scan changed"
msgstr "Wi-Fi-nätverken har ändrats"

#: src/wifi_analyzer/app.py:1073
#, python-brace-format
msgid "{new} new, {gone} gone, {changed} changed access points"
msgstr "{new} nya, {gone} försvunna, {changed} ändrade åtkomstpunkter"

#: src/wifi_analyzer/app.py:1125
#, python-brace-format
msgid "Least congested channel: {channel} (overlap score {score})"
msgstr ""
"Kanal med minst beräknad överlappning: {channel} (överlappningspoäng {score})"

#: src/wifi_analyzer/app.py:1128
msgid "No channel recommendation available"
msgstr "Ingen kanal kunde rekommenderas"

#: src/wifi_analyzer/app.py:1137
msgid "Export"
msgstr "Exportera"

#: src/wifi_analyzer/app.py:1137
msgid "Cancel"
msgstr "Avbryt"

#: src/wifi_analyzer/app.py:1149
#, python-brace-format
msgid "Export failed: {error}"
msgstr "Exporten misslyckades: {error}"

#: src/wifi_analyzer/app.py:1159
#, python-brace-format
