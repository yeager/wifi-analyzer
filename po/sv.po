#: src/wifi_analyzer/app.py:123
msgid "Unavailable in the detected regulatory domain"
msgstr "Inte tillgänglig i den upptäckta regleringsdomänen"

#: src/wifi_analyzer/app.py:125
msgid "DFS — radar detection may interrupt this channel"
msgstr "DFS — radardetektering kan avbryta denna kanal"

#: src/wifi_analyzer/app.py:127
msgid "DFS — availability depends on local regulations"
msgstr "DFS — tillgängligheten beror på lokala regler"

#: src/wifi_analyzer/app.py:200 src/wifi_analyzer/app.py:342
msgid "No Wi-Fi device found"
msgstr "Ingen Wi-Fi-enhet hittades"

#: src/wifi_analyzer/app.py:201
msgid ""
"Enable Wi-Fi in system settings, disable airplane mode, and check the "
"adapter driver."
msgstr "Aktivera Wi-Fi i systeminställningarna, stäng av flygplansläge och kontrollera adapterns drivrutin."

#: src/wifi_analyzer/app.py:204
msgid "Wi-Fi signal is weak"
msgstr "Wi-Fi-signalen är svag"

#: src/wifi_analyzer/app.py:205
msgid ""
"Move closer to the access point, reduce obstructions, or select a less "
"congested channel."
msgstr "Flytta närmare åtkomstpunkten, minska hinder eller välj en mindre belastad kanal."

#: src/wifi_analyzer/app.py:208
msgid "Wi-Fi connection was lost"
msgstr "Wi-Fi-anslutningen bröts"

#: src/wifi_analyzer/app.py:209
msgid ""
"Check the access point, reconnect from system settings, and inspect the "
"gateway and DNS diagnostics."
msgstr "Kontrollera åtkomstpunkten, återanslut i systeminställningarna och granska gateway- och DNS-diagnostiken."

#: src/wifi_analyzer/app.py:211
msgid "Wi-Fi access point changed"
msgstr "Wi-Fi-åtkomstpunkten ändrades"

#: src/wifi_analyzer/app.py:212
msgid ""
"Roaming can be normal. If it causes interruptions, compare signal history "
"and access-point overlap."
msgstr "Roaming kan vara normalt. Om det orsakar avbrott kan du jämföra signalhistorik och åtkomstpunktsöverlappning."

#: src/wifi_analyzer/app.py:340
msgid "Error: no WiFi device found"
msgstr "Fel: ingen Wi-Fi-enhet hittades"

#: src/wifi_analyzer/app.py:380 src/wifi_analyzer/app.py:858
msgid "<Hidden>"
msgstr "<Dold>"

#: src/wifi_analyzer/app.py:459
msgid "No networks found"
msgstr "Inga nätverk hittades"

#: src/wifi_analyzer/app.py:588
msgid "measured"
msgstr "uppmätt"

#: src/wifi_analyzer/app.py:588
msgid "estimated"
msgstr "uppskattad"

#: src/wifi_analyzer/app.py:592
#, python-brace-format
msgid " · seen {seconds}s ago"
msgstr " · sedd för {seconds} s sedan"

#: src/wifi_analyzer/app.py:593
msgid " · Connected"
msgstr " · Ansluten"

#: src/wifi_analyzer/app.py:594
#, python-brace-format
msgid ""
"Ch {channel} · {band} · {frequency} MHz{width}{active} · {dbm} dBm · "
"{security} · {bssid}{seen}{dfs}"
msgstr "Kanal {channel} · {band} · {frequency} MHz{width}{active} · {dbm} dBm · {security} · {bssid}{seen}{dfs}"

#: src/wifi_analyzer/app.py:596 src/wifi_analyzer/app.py:694
#: src/wifi_analyzer/app.py:856
msgid "Open"
msgstr "Öppet"

#: src/wifi_analyzer/app.py:613 src/wifi_analyzer/app.py:944
msgid "WiFi Analyzer"
msgstr "WiFi-analyserare"

#: src/wifi_analyzer/app.py:621
msgid "Toggle theme"
msgstr "Växla tema"

#: src/wifi_analyzer/app.py:626
msgid "Export CSV"
msgstr "Exportera CSV"

#: src/wifi_analyzer/app.py:627
msgid "Export JSON"
msgstr "Exportera JSON"

#: src/wifi_analyzer/app.py:628
msgid "Export anonymized JSON"
msgstr "Exportera anonymiserad JSON"

#: src/wifi_analyzer/app.py:629
msgid "Export diagnostic report"
msgstr "Exportera diagnostikrapport"

#: src/wifi_analyzer/app.py:630
msgid "Connection diagnostics"
msgstr "Anslutningsdiagnostik"

#: src/wifi_analyzer/app.py:631
msgid "Clear local history"
msgstr "Rensa lokal historik"

#: src/wifi_analyzer/app.py:632
msgid "About"
msgstr "Om"

#: src/wifi_analyzer/app.py:636
msgid "Scan"
msgstr "Sök"

#: src/wifi_analyzer/app.py:639
msgid "Monitor"
msgstr "Övervaka"

#: src/wifi_analyzer/app.py:639
msgid "Scan every 60 seconds and notify about changes"
msgstr "Sök av var 60:e sekund och avisera om ändringar"

#: src/wifi_analyzer/app.py:674
msgid "Filter by name, BSSID, channel or security"
msgstr "Filtrera efter namn, BSSID, kanal eller säkerhet"

#: src/wifi_analyzer/app.py:683
msgid "Minimum signal"
msgstr "Lägsta signal"

#: src/wifi_analyzer/app.py:687
msgid "Only show access points at or above this estimated dBm value"
msgstr "Visa endast åtkomstpunkter vid eller över detta uppskattade dBm-värde"

#: src/wifi_analyzer/app.py:691 src/wifi_analyzer/app.py:704
#: src/wifi_analyzer/app.py:863
msgid "Security"
msgstr "Säkerhet"

#: src/wifi_analyzer/app.py:694 src/wifi_analyzer/app.py:855
msgid "All security"
msgstr "Alla säkerhetstyper"

#: src/wifi_analyzer/app.py:699
msgid "Hidden SSIDs only"
msgstr "Endast dolda SSID:er"

#: src/wifi_analyzer/app.py:703
msgid "Sort"
msgstr "Sortera"

#: src/wifi_analyzer/app.py:704
msgid "Signal"
msgstr "Signal"

#: src/wifi_analyzer/app.py:704 src/wifi_analyzer/app.py:861
msgid "Channel"
msgstr "Kanal"

#: src/wifi_analyzer/app.py:707
msgid "Profile"
msgstr "Profil"

#: src/wifi_analyzer/app.py:709
msgid "Keep local scan history separate for this location"
msgstr "Håll lokal sökhistorik separat för denna plats"

#: src/wifi_analyzer/app.py:737
msgid "Ready — click Scan"
msgstr "Redo — klicka på Sök"

#: src/wifi_analyzer/app.py:774
#, python-brace-format
msgid "Main overlapping access points: {names}"
msgstr "Främsta överlappande åtkomstpunkter: {names}"

#: src/wifi_analyzer/app.py:776
msgid "No overlapping access points detected"
msgstr "Inga överlappande åtkomstpunkter hittades"

#: src/wifi_analyzer/app.py:782
msgid "Scanning..."
msgstr "Söker..."

#: src/wifi_analyzer/app.py:796
msgid "Monitoring enabled; scanning every 60 seconds"
msgstr "Övervakning aktiverad; söker av var 60:e sekund"

#: src/wifi_analyzer/app.py:800
msgid "Monitoring disabled"
msgstr "Övervakning inaktiverad"

#: src/wifi_analyzer/app.py:823
#, python-brace-format
msgid "Scan failed: {error}"
msgstr "Sökningen misslyckades: {error}"

#: src/wifi_analyzer/app.py:825
#, python-brace-format
msgid "Found {count} networks{suffix}"
msgstr "Hittade {count} nätverk{suffix}"

#: src/wifi_analyzer/app.py:827
msgid "WiFi scan changed"
msgstr "Wi-Fi-sökningen ändrades"

#: src/wifi_analyzer/app.py:828
#, python-brace-format
msgid "{new} new, {gone} gone, {changed} changed access points"
msgstr "{new} nya, {gone} försvunna, {changed} ändrade åtkomstpunkter"

#: src/wifi_analyzer/app.py:875
#, python-brace-format
msgid "Least congested channel: {channel} (overlap score {score})"
msgstr "Minst belastade kanal: {channel} (överlappningspoäng {score})"

#: src/wifi_analyzer/app.py:878
msgid "No channel recommendation available"
msgstr "Ingen kanalrekommendation är tillgänglig"

#: src/wifi_analyzer/app.py:887
#, python-brace-format
msgid "Exported CSV to {path}"
msgstr "Exporterade CSV till {path}"

#: src/wifi_analyzer/app.py:892
#, python-brace-format
msgid "Exported JSON to {path}"
msgstr "Exporterade JSON till {path}"

#: src/wifi_analyzer/app.py:898
#, python-brace-format
