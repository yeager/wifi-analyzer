msgid "Export diagnostic report"
msgstr "Exportera diagnostikrapport"

#: src/wifi_analyzer/app.py:933 src/wifi_analyzer/app.py:1289
msgid "Connection diagnostics"
msgstr "Anslutningsdiagnostik"

#: src/wifi_analyzer/app.py:934
msgid "Clear local history"
msgstr "Rensa lokal historik"

#: src/wifi_analyzer/app.py:935
msgid "About"
msgstr "Om"

#: src/wifi_analyzer/app.py:939
msgid "Scan"
msgstr "Skanna"

#: src/wifi_analyzer/app.py:942
msgid "Monitor"
msgstr "Övervaka"

#: src/wifi_analyzer/app.py:942
msgid "Scan every 60 seconds and notify about changes"
msgstr "Skanna var 60:e sekund och meddela när nätverken ändras"

#: src/wifi_analyzer/app.py:977
msgid "Filter by name, BSSID, channel or security"
msgstr "Filtrera efter namn, BSSID, kanal eller säkerhetstyp"

#: src/wifi_analyzer/app.py:986
msgid "Minimum signal"
msgstr "Minsta signalstyrka"

#: src/wifi_analyzer/app.py:990
msgid "Only show access points at or above this estimated dBm value"
msgstr ""
"Visa bara åtkomstpunkter med minst den här uppskattade signalstyrkan (dBm)"

#: src/wifi_analyzer/app.py:994 src/wifi_analyzer/app.py:1007
#: src/wifi_analyzer/app.py:1196
msgid "Security"
msgstr "Säkerhet"

#: src/wifi_analyzer/app.py:997 src/wifi_analyzer/app.py:1188
msgid "All security"
msgstr "Alla säkerhetstyper"

#: src/wifi_analyzer/app.py:1002
msgid "Hidden SSIDs only"
msgstr "Endast dolda SSID:er"

#: src/wifi_analyzer/app.py:1006
msgid "Sort"
msgstr "Sortera"

#: src/wifi_analyzer/app.py:1007
msgid "Signal"
msgstr "Signal"

#: src/wifi_analyzer/app.py:1007 src/wifi_analyzer/app.py:1194
msgid "Channel"
msgstr "Kanal"

#: src/wifi_analyzer/app.py:1010
msgid "Profile"
msgstr "Profil"

#: src/wifi_analyzer/app.py:1012
msgid "Keep local scan history separate for this location"
msgstr "Spara separat skanningshistorik för den här profilen"

#: src/wifi_analyzer/app.py:1046
msgid "Ready — click Scan"
msgstr "Redo — välj Skanna"

#: src/wifi_analyzer/app.py:1090
#, python-brace-format
msgid "Main overlapping access points: {names}"
msgstr "Åtkomstpunkter med störst överlappning: {names}"

#: src/wifi_analyzer/app.py:1092
msgid "No overlapping access points detected"
msgstr "Inga överlappande åtkomstpunkter hittades"

#: src/wifi_analyzer/app.py:1099
msgid "Signal history"
msgstr "Signalhistorik"

#: src/wifi_analyzer/app.py:1103
#, python-brace-format
msgid "Local history for profile: {profile}"
msgstr "Lokal historik för profil: {profile}"

#: src/wifi_analyzer/app.py:1112
msgid "Scanning..."
msgstr "Skannar..."

#: src/wifi_analyzer/app.py:1126
msgid "Monitoring enabled; scanning every 60 seconds"
msgstr "Övervakning aktiverad; söker av var 60:e sekund"

#: src/wifi_analyzer/app.py:1130
msgid "Monitoring disabled"
msgstr "Övervakning inaktiverad"

#: src/wifi_analyzer/app.py:1151
#, python-brace-format
msgid " · {new} new, {gone} gone"
msgstr " · nya: {new}, försvunna: {gone}"

#: src/wifi_analyzer/app.py:1155
#, python-brace-format
msgid "Scan failed: {error}"
msgstr "Skanningen misslyckades: {error}"

#: src/wifi_analyzer/app.py:1157
#, python-brace-format
msgid "Found {count} networks{suffix}"
msgstr "Hittade {count} nätverk{suffix}"

#: src/wifi_analyzer/app.py:1159
msgid "WiFi scan changed"
msgstr "Wi-Fi-nätverken har ändrats"

#: src/wifi_analyzer/app.py:1160
#, python-brace-format
msgid "{new} new, {gone} gone, {changed} changed access points"
msgstr "{new} nya, {gone} försvunna, {changed} ändrade åtkomstpunkter"

#: src/wifi_analyzer/app.py:1221
msgid "Export"
msgstr "Exportera"

#: src/wifi_analyzer/app.py:1221 src/wifi_analyzer/app.py:1256
msgid "Cancel"
msgstr "Avbryt"

#: src/wifi_analyzer/app.py:1233
#, python-brace-format
msgid "Export failed: {error}"
msgstr "Exporten misslyckades: {error}"

#: src/wifi_analyzer/app.py:1243
#, python-brace-format
msgid "Exported CSV to {path}"
msgstr "CSV-filen exporterades till {path}"

#: src/wifi_analyzer/app.py:1250
#, python-brace-format
msgid "Exported JSON to {path}"
msgstr "JSON-filen exporterades till {path}"

#: src/wifi_analyzer/app.py:1255
msgid ""
"This export hides network names (SSIDs), access point MAC addresses (BSSIDs) "
"and connection-specific details. It keeps band, frequency, channel, signal, "
"width and security or regulatory details. Those details may still identify a "
"location, so review the file before sharing it."
msgstr ""
"Den här exporten döljer nätverksnamn (SSID), åtkomstpunkternas MAC-adresser "
"(BSSID) och anslutningsspecifika uppgifter. Band, frekvens, kanal, "
"signalstyrka, kanalbredd och säkerhets- eller regelverksinformation finns "
"kvar. Uppgifterna kan ändå avslöja var du befinner dig. Granska filen innan "
"du delar den."

#: src/wifi_analyzer/app.py:1257
msgid "Continue to export"
msgstr "Fortsätt exportera"

#: src/wifi_analyzer/app.py:1264
#, python-brace-format
msgid "Exported anonymized JSON to {path}"
msgstr "Den anonymiserade JSON-filen exporterades till {path}"

#: src/wifi_analyzer/app.py:1281
#, python-brace-format
msgid "Exported diagnostic report to {path}"
msgstr "Diagnostikrapporten exporterades till {path}"

#: src/wifi_analyzer/app.py:1286 src/wifi_analyzer/app.py:1287
#: src/wifi_analyzer/app.py:1288 src/wifi_analyzer/app.py:1291
msgid "unavailable"
msgstr "inte tillgänglig"

#: src/wifi_analyzer/app.py:1290
#, python-brace-format
msgid ""
"Gateway: {gateway}\n"
"DNS: {dns}\n"
"IP addresses: {addresses}\n"
"Link rate: {rates}"
msgstr ""
"Gateway: {gateway}\n"
"DNS: {dns}\n"
"IP-adresser: {addresses}\n"
"Länkhastighet: {rates}"

#: src/wifi_analyzer/app.py:1292
msgid "Close"
msgstr "Stäng"

#: src/wifi_analyzer/app.py:1297
msgid "Cleared local scan history"
msgstr "Den lokala skanningshistoriken har rensats"

#: src/wifi_analyzer/app.py:1311
msgid "WiFi Network Analysis Tool"
msgstr "Verktyg för analys av Wi-Fi-nätverk"

#: src/wifi_analyzer/app.py:1313
msgid "Created by"
msgstr "Skapad av"

#: src/wifi_analyzer/app.py:1314
msgid "With thanks to"
msgstr "Med tack till"

#: src/wifi_analyzer/app.py:1317
msgid "Project on GitHub"
msgstr "Projekt på GitHub"

#: src/wifi_analyzer/app.py:1349
msgid "Welcome"
msgstr "Välkommen"

#: src/wifi_analyzer/app.py:1354
msgid "Welcome to WiFi Analyzer"
msgstr "Välkommen till WiFi Analyzer"

#: src/wifi_analyzer/app.py:1355
msgid ""
"Analyze WiFi networks.\n"
"\n"
"✓ Scan nearby networks\n"
"✓ Signal strength monitoring\n"
"✓ Channel overlap detection"
msgstr ""
"Analysera Wi-Fi-nätverk.\n"
"\n"
"✓ Skanna nätverk i närheten\n"
"✓ Övervakning av signalstyrka\n"
"✓ Upptäck kanalöverlappning"

