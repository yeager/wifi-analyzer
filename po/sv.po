msgid "Open"
msgstr "Öppet nätverk"

#: src/wifi_analyzer/app.py:891
msgid "No local signal history yet"
msgstr "Ingen lokal signalhistorik ännu"

#: src/wifi_analyzer/app.py:915 src/wifi_analyzer/app.py:1324
msgid "WiFi Analyzer"
msgstr "WiFi Analyzer"

#: src/wifi_analyzer/app.py:924
msgid "Toggle theme"
msgstr "Byt tema"

#: src/wifi_analyzer/app.py:929 src/wifi_analyzer/app.py:1244
msgid "Export CSV"
msgstr "Exportera CSV"

#: src/wifi_analyzer/app.py:930 src/wifi_analyzer/app.py:1251
