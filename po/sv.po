#: src/wifi_analyzer/app.py:215
msgid "Unavailable in the detected regulatory domain"
msgstr "Inte tillgänglig i den upptäckta regleringsdomänen"

#: src/wifi_analyzer/app.py:217
msgid "DFS — radar detection may interrupt this channel"
msgstr "DFS — radardetektering kan avbryta denna kanal"

#: src/wifi_analyzer/app.py:219
msgid "DFS — availability depends on local regulations"
msgstr "DFS — tillgängligheten beror på lokala regler"

#: src/wifi_analyzer/app.py:294 src/wifi_analyzer/app.py:299
#: src/wifi_analyzer/app.py:303
msgid "No channel recommendation available"
msgstr "Ingen kanal kunde rekommenderas"

#: src/wifi_analyzer/app.py:295
msgid ""
"The scan did not complete, so nearby access points could not be compared."
msgstr ""
"Skanningen slutfördes inte, så det gick inte att jämföra närliggande "
"åtkomstpunkter."

#: src/wifi_analyzer/app.py:300
msgid ""
"Nearby access points were found, but the detected regulatory information "
"lists no candidate channel that can initiate transmission. Check the "
"router’s country and channel settings."
msgstr ""
"Närliggande åtkomstpunkter hittades, men den upptäckta "
"regleringsinformationen anger ingen kandidatkanal som får inleda sändning. "
"Kontrollera routerns lands- och kanalinställningar."

#: src/wifi_analyzer/app.py:304
msgid "Scan this band to compare nearby access points."
msgstr "Sök efter nätverk på det här bandet för att jämföra dem."

#: src/wifi_analyzer/app.py:308
#, python-brace-format
msgid ""
"Lowest estimated overlap in this scan: channel {channel} (score {score})"
msgstr ""
"Lägst beräknad överlappning i den här skanningen: kanal {channel} (poäng "
"{score})"

#: src/wifi_analyzer/app.py:311
msgid ""
"Lower scores mean less estimated overlap. The candidate is estimated at 20 "
"MHz; reported access point widths are used when available. Only access "
"points found in this scan count; client traffic and hidden networks are not "
"measured."
msgstr ""
"Lägre poäng betyder mindre beräknad överlappning. Bedömningen räknar med 20 "
"MHz för den föreslagna kanalen och använder rapporterad bredd för "
"åtkomstpunkter när den finns. Den räknar bara nätverk som hittas vid "
"skanningen och tar inte med trafik eller dolda nätverk."

#: src/wifi_analyzer/app.py:328
msgid ""
"Security advice: The connected access point advertises an older Wi-Fi "
"security mode. If you manage it, use WPA2 with AES or WPA3 and disable WEP/"
"WPA1. The scan cannot tell which cipher your connection uses."
msgstr ""
"Säkerhetsråd: Den anslutna åtkomstpunkten använder ett äldre Wi-Fi-"
"säkerhetsläge. Om du ansvarar för routern bör du använda WPA2 med AES eller "
"WPA3 och stänga av WEP och WPA1. Skanningen visar inte vilket "
"krypteringsläge anslutningen använder."

#: src/wifi_analyzer/app.py:335
msgid ""
"Security advice: Enhanced Open encrypts Wi-Fi traffic but does not "
"authenticate the access point. Check the network name with the venue or "
"network owner before using it."
msgstr ""
"Säkerhetsråd: Enhanced Open krypterar Wi-Fi-trafiken men verifierar inte "
"åtkomstpunkten. Kontrollera nätverksnamnet med verksamheten eller "
"nätverksansvarig innan du använder nätet."

#: src/wifi_analyzer/app.py:341
msgid ""
"Security advice: The connected access point reports no Wi-Fi security. Avoid "
"sensitive activity on this network until you have checked what protection it "
"provides. HTTPS protects only connections to sites that use it."
msgstr ""
"Säkerhetsråd: Den anslutna åtkomstpunkten rapporterar inget Wi-Fi-skydd. "
"Undvik känsliga ärenden på nätverket tills du vet vilket skydd som finns. "
"HTTPS skyddar bara anslutningar till webbplatser som använder det."

#: src/wifi_analyzer/app.py:445 src/wifi_analyzer/app.py:1107
msgid "Wi-Fi scan failed"
msgstr "Det gick inte att söka efter Wi-Fi-nätverk"

#: src/wifi_analyzer/app.py:447
msgid ""
"Check that NetworkManager is running and your Wi-Fi adapter is enabled. For "
"Flatpak, make sure the app can access NetworkManager."
msgstr ""
"Kontrollera att NetworkManager är igång och att wifi-adaptern är på. I "
"Flatpak måste appen få ansluta till NetworkManager."

#: src/wifi_analyzer/app.py:452 src/wifi_analyzer/app.py:760
msgid "No Wi-Fi device found"
msgstr "Ingen Wi-Fi-enhet hittades"

#: src/wifi_analyzer/app.py:453
msgid ""
"Enable Wi-Fi in system settings, disable airplane mode, and check the "
"adapter driver."
msgstr ""
"Aktivera Wi-Fi i systeminställningarna, stäng av flygplansläge och "
"kontrollera adapterns drivrutin."

#: src/wifi_analyzer/app.py:457
msgid "No access points found"
msgstr "Inga åtkomstpunkter hittades"

#: src/wifi_analyzer/app.py:459
msgid ""
"No nearby access points were found in this scan. Check that Wi-Fi is "
"enabled, airplane mode is off, and move closer to the router before scanning "
"again. Hidden networks may not appear."
msgstr ""
"Inga närliggande åtkomstpunkter hittades vid den här sökningen. Kontrollera "
"att Wi-Fi är aktiverat och att flygplansläget är av. Gå närmare routern och "
"sök igen. Dolda nätverk kanske inte visas."

#: src/wifi_analyzer/app.py:466
msgid "Wi-Fi signal is weak"
msgstr "Wi-Fi-signalen är svag"

#: src/wifi_analyzer/app.py:467
msgid ""
"Move closer to the access point, reduce obstructions, or select a less "
"congested channel."
msgstr ""
"Flytta dig närmare åtkomstpunkten, minska antalet hinder mellan dig och den "
"eller välj en mindre belastad kanal."

#: src/wifi_analyzer/app.py:470
msgid "Wi-Fi connection was lost"
msgstr "Wi-Fi-anslutningen bröts"

#: src/wifi_analyzer/app.py:471
msgid ""
"Check the access point, reconnect from system settings, and inspect the "
"gateway and DNS diagnostics."
msgstr ""
"Kontrollera åtkomstpunkten, återanslut i systeminställningarna och granska "
"gateway- och DNS-diagnostiken."

#: src/wifi_analyzer/app.py:473
msgid "Wi-Fi access point changed"
msgstr "Wi-Fi-åtkomstpunkten ändrades"

#: src/wifi_analyzer/app.py:474
msgid ""
"Roaming can be normal. If it causes interruptions, compare signal history "
"and access-point overlap."
msgstr ""
"Det är normalt att enheten växlar mellan åtkomstpunkter. Om det leder till "
"avbrott kan du jämföra signalhistoriken och se hur åtkomstpunkterna "
"överlappas."

#: src/wifi_analyzer/app.py:600 src/wifi_analyzer/app.py:1195
msgid "No local signal history yet"
msgstr "Ingen lokal signalhistorik ännu"

#: src/wifi_analyzer/app.py:602
#, python-brace-format
msgid ""
"Signal history: {count} measurements, range {minimum}% to {maximum}%, latest "
"{latest}%."
msgstr ""
"Signalhistorik: {count} mätningar, mellan {minimum} och {maximum} %. Senaste "
"värdet är {latest} %."

