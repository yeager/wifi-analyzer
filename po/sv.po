#: src/wifi_analyzer/app.py:173
msgid "Unavailable in the detected regulatory domain"
msgstr "Inte tillgänglig i den upptäckta regleringsdomänen"

#: src/wifi_analyzer/app.py:175
msgid "DFS — radar detection may interrupt this channel"
msgstr "DFS — radardetektering kan avbryta denna kanal"

#: src/wifi_analyzer/app.py:177
msgid "DFS — availability depends on local regulations"
msgstr "DFS — tillgängligheten beror på lokala regler"

#: src/wifi_analyzer/app.py:242
msgid "No channel recommendation available"
msgstr "Ingen kanal kunde rekommenderas"

#: src/wifi_analyzer/app.py:243
msgid "Scan this band to compare nearby access points."
msgstr "Sök efter nätverk på det här bandet för att jämföra dem."

#: src/wifi_analyzer/app.py:247
#, python-brace-format
msgid ""
"Lowest estimated overlap in this scan: channel {channel} (score {score})"
msgstr ""
"Lägst beräknad överlappning i den här skanningen: kanal {channel} (poäng "
"{score})"

#: src/wifi_analyzer/app.py:250
msgid ""
"Lower scores mean less estimated overlap. Only access points found in this "
"scan count; client traffic and hidden networks are not measured."
msgstr ""
"Lägre poäng betyder mindre beräknad överlappning. Bedömningen räknar bara "
"nätverk som hittas vid skanningen och tar inte med trafik eller dolda "
"nätverk."

#: src/wifi_analyzer/app.py:298
msgid "Wi-Fi scan failed"
msgstr "Det gick inte att söka efter Wi-Fi-nätverk"

#: src/wifi_analyzer/app.py:300
msgid ""
"Check that NetworkManager is running and your Wi-Fi adapter is enabled. For "
"Flatpak, make sure the app can access NetworkManager."
msgstr ""
"Kontrollera att NetworkManager är igång och att wifi-adaptern är på. I "
"Flatpak måste appen få ansluta till NetworkManager."

#: src/wifi_analyzer/app.py:305 src/wifi_analyzer/app.py:482
msgid "No Wi-Fi device found"
msgstr "Ingen Wi-Fi-enhet hittades"

#: src/wifi_analyzer/app.py:306
msgid ""
"Enable Wi-Fi in system settings, disable airplane mode, and check the "
"adapter driver."
msgstr ""
"Aktivera Wi-Fi i systeminställningarna, stäng av flygplansläge och "
"kontrollera adapterns drivrutin."

#: src/wifi_analyzer/app.py:309
msgid "Wi-Fi signal is weak"
msgstr "Wi-Fi-signalen är svag"

#: src/wifi_analyzer/app.py:310
msgid ""
"Move closer to the access point, reduce obstructions, or select a less "
"congested channel."
msgstr ""
"Flytta dig närmare åtkomstpunkten, minska antalet hinder mellan dig och den "
"eller välj en mindre belastad kanal."

#: src/wifi_analyzer/app.py:313
msgid "Wi-Fi connection was lost"
msgstr "Wi-Fi-anslutningen bröts"

#: src/wifi_analyzer/app.py:314
msgid ""
"Check the access point, reconnect from system settings, and inspect the "
"gateway and DNS diagnostics."
msgstr ""
"Kontrollera åtkomstpunkten, återanslut i systeminställningarna och granska "
"gateway- och DNS-diagnostiken."

#: src/wifi_analyzer/app.py:316
msgid "Wi-Fi access point changed"
msgstr "Wi-Fi-åtkomstpunkten ändrades"

#: src/wifi_analyzer/app.py:317
msgid ""
"Roaming can be normal. If it causes interruptions, compare signal history "
"and access-point overlap."
msgstr ""
"Det är normalt att enheten växlar mellan åtkomstpunkter. Om det leder till "
"avbrott kan du jämföra signalhistoriken och se hur åtkomstpunkterna "
"överlappas."

#: src/wifi_analyzer/app.py:480
msgid "Error: no WiFi device found"
msgstr "Fel: ingen Wi-Fi-enhet hittades"

#: src/wifi_analyzer/app.py:521 src/wifi_analyzer/app.py:1102
#: src/wifi_analyzer/app.py:1191
msgid "<Hidden>"
msgstr "<Dold>"

#: src/wifi_analyzer/app.py:590
msgid ""
"Focus the chart and use the Left and Right Arrow keys to choose a channel. "
"Press Home or End to jump to the first or last channel. Press Enter or Space "
"to filter the network list. Scroll to zoom."
msgstr ""
"Sätt fokus på diagrammet och använd vänster- och högerpiltangenterna för att "
"välja kanal. Tryck på Home eller End för att hoppa till den första eller "
"sista kanalen. Tryck på Retur eller blanksteg för att filtrera "
"nätverkslistan. Rulla för att ändra zoomnivån."

#: src/wifi_analyzer/app.py:593
msgid "Channel overlap chart"
msgstr "Diagram över kanalöverlappning"

#: src/wifi_analyzer/app.py:641
#, python-brace-format
msgid "Channel {channel}. Press Enter to filter the network list."
msgstr "Kanal {channel}. Tryck på Retur för att filtrera nätverkslistan."

#: src/wifi_analyzer/app.py:651
msgid "Channel filter cleared."
msgstr "Kanalfiltreringen har rensats."

#: src/wifi_analyzer/app.py:653
#, python-brace-format
msgid "Filtering access points by channel {channel}."
msgstr "Visar åtkomstpunkter på kanal {channel}."

#: src/wifi_analyzer/app.py:717
msgid "No networks found"
msgstr "Inga nätverk hittades"

#: src/wifi_analyzer/app.py:850
msgid "measured"
msgstr "uppmätt"

#: src/wifi_analyzer/app.py:850
msgid "estimated"
msgstr "uppskattad"

#: src/wifi_analyzer/app.py:853
msgid " · Connected"
msgstr " · Ansluten"

#: src/wifi_analyzer/app.py:854
#, python-brace-format
msgid ""
"Ch {channel} · {frequency} MHz{width}{active} · {dbm} dBm · {security} · "
"{bssid}"
msgstr ""
"Kanal {channel} · {frequency} MHz{width}{active} · {dbm} dBm · {security} · "
"{bssid}"

