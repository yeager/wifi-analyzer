#: src/wifi_analyzer/app.py:191
msgid "Unavailable in the detected regulatory domain"
msgstr "Inte tillgänglig i den upptäckta regleringsdomänen"

#: src/wifi_analyzer/app.py:193
msgid "DFS — radar detection may interrupt this channel"
msgstr "DFS — radardetektering kan avbryta denna kanal"

#: src/wifi_analyzer/app.py:195
msgid "DFS — availability depends on local regulations"
msgstr "DFS — tillgängligheten beror på lokala regler"

#: src/wifi_analyzer/app.py:260
msgid "No channel recommendation available"
msgstr "Ingen kanal kunde rekommenderas"

#: src/wifi_analyzer/app.py:261
msgid "Scan this band to compare nearby access points."
msgstr "Sök efter nätverk på det här bandet för att jämföra dem."

#: src/wifi_analyzer/app.py:265
#, python-brace-format
msgid ""
"Lowest estimated overlap in this scan: channel {channel} (score {score})"
msgstr ""
"Lägst beräknad överlappning i den här skanningen: kanal {channel} (poäng "
"{score})"

#: src/wifi_analyzer/app.py:268
msgid ""
"Lower scores mean less estimated overlap. Only access points found in this "
"scan count; client traffic and hidden networks are not measured."
msgstr ""
"Lägre poäng betyder mindre beräknad överlappning. Bedömningen räknar bara "
"nätverk som hittas vid skanningen och tar inte med trafik eller dolda "
"nätverk."

#: src/wifi_analyzer/app.py:334
msgid "Wi-Fi scan failed"
msgstr "Det gick inte att söka efter Wi-Fi-nätverk"

#: src/wifi_analyzer/app.py:336
msgid ""
"Check that NetworkManager is running and your Wi-Fi adapter is enabled. For "
"Flatpak, make sure the app can access NetworkManager."
msgstr ""
"Kontrollera att NetworkManager är igång och att wifi-adaptern är på. I "
"Flatpak måste appen få ansluta till NetworkManager."

#: src/wifi_analyzer/app.py:341 src/wifi_analyzer/app.py:617
msgid "No Wi-Fi device found"
msgstr "Ingen Wi-Fi-enhet hittades"

#: src/wifi_analyzer/app.py:342
msgid ""
"Enable Wi-Fi in system settings, disable airplane mode, and check the "
"adapter driver."
msgstr ""
"Aktivera Wi-Fi i systeminställningarna, stäng av flygplansläge och "
"kontrollera adapterns drivrutin."

#: src/wifi_analyzer/app.py:346
msgid "No access points found"
msgstr "Inga åtkomstpunkter hittades"

#: src/wifi_analyzer/app.py:348
msgid "No nearby access points were found in this scan. Check that Wi-Fi is enabled, airplane mode is off, and move closer to the router before scanning again. Hidden networks may not appear."
msgstr "Inga närliggande åtkomstpunkter hittades vid den här sökningen. Kontrollera att Wi-Fi är aktiverat och att flygplansläget är av. Gå närmare routern och sök igen. Dolda nätverk kanske inte visas."

#: src/wifi_analyzer/app.py:345
msgid "Wi-Fi signal is weak"
msgstr "Wi-Fi-signalen är svag"

#: src/wifi_analyzer/app.py:346
msgid ""
"Move closer to the access point, reduce obstructions, or select a less "
"congested channel."
msgstr ""
"Flytta dig närmare åtkomstpunkten, minska antalet hinder mellan dig och den "
"eller välj en mindre belastad kanal."

#: src/wifi_analyzer/app.py:349
msgid "Wi-Fi connection was lost"
msgstr "Wi-Fi-anslutningen bröts"

#: src/wifi_analyzer/app.py:350
msgid ""
"Check the access point, reconnect from system settings, and inspect the "
"gateway and DNS diagnostics."
msgstr ""
"Kontrollera åtkomstpunkten, återanslut i systeminställningarna och granska "
"gateway- och DNS-diagnostiken."

#: src/wifi_analyzer/app.py:352
msgid "Wi-Fi access point changed"
msgstr "Wi-Fi-åtkomstpunkten ändrades"

#: src/wifi_analyzer/app.py:353
msgid ""
"Roaming can be normal. If it causes interruptions, compare signal history "
"and access-point overlap."
msgstr ""
"Det är normalt att enheten växlar mellan åtkomstpunkter. Om det leder till "
"avbrott kan du jämföra signalhistoriken och se hur åtkomstpunkterna "
"överlappas."

#: src/wifi_analyzer/app.py:474 src/wifi_analyzer/app.py:1020
msgid "No local signal history yet"
msgstr "Ingen lokal signalhistorik ännu"

#: src/wifi_analyzer/app.py:476
#, python-brace-format
msgid ""
"Signal history: {count} measurements, range {minimum}% to {maximum}%, latest "
"{latest}%."
msgstr ""
"Signalhistorik: {count} mätningar, mellan {minimum} och {maximum} %. Senaste "
"värdet är {latest} %."

#: src/wifi_analyzer/app.py:491 src/wifi_analyzer/app.py:1229
msgid "Signal history"
msgstr "Signalhistorik"

#: src/wifi_analyzer/app.py:506
#, python-brace-format
msgid "{time}: {signal}%"
msgstr "{time}: {signal} %"

#: src/wifi_analyzer/app.py:615
msgid "Error: no WiFi device found"
msgstr "Fel: ingen Wi-Fi-enhet hittades"

#: src/wifi_analyzer/app.py:649 src/wifi_analyzer/app.py:1232
#: src/wifi_analyzer/app.py:1356
msgid "<Hidden>"
msgstr "<Dold>"

#: src/wifi_analyzer/app.py:718
msgid ""
"Focus the chart and use the Left and Right Arrow keys to choose a channel. "
"Press Home or End to jump to the first or last channel. Press Enter or Space "
"to filter the network list. Scroll to zoom."
msgstr ""
"Sätt fokus på diagrammet och använd vänster- och högerpiltangenterna för att "
"välja kanal. Tryck på Home eller End för att hoppa till den första eller "
"sista kanalen. Tryck på Retur eller blanksteg för att filtrera "
"nätverkslistan. Rulla för att ändra zoomnivån."

#: src/wifi_analyzer/app.py:721
msgid "Channel overlap chart"
msgstr "Diagram över kanalöverlappning"

#: src/wifi_analyzer/app.py:769
#, python-brace-format
msgid "Channel {channel}. Press Enter to filter the network list."
msgstr "Kanal {channel}. Tryck på Retur för att filtrera nätverkslistan."

#: src/wifi_analyzer/app.py:779
msgid "Channel filter cleared."
msgstr "Kanalfiltreringen har rensats."

#: src/wifi_analyzer/app.py:781
#, python-brace-format
msgid "Filtering access points by channel {channel}."
msgstr "Visar åtkomstpunkter på kanal {channel}."

#: src/wifi_analyzer/app.py:845
msgid "No networks found"
msgstr "Inga nätverk hittades"

#: src/wifi_analyzer/app.py:978
msgid "measured"
msgstr "uppmätt"

#: src/wifi_analyzer/app.py:978
msgid "estimated"
msgstr "uppskattad"

#: src/wifi_analyzer/app.py:981
msgid " · Connected"
msgstr " · Ansluten"

#: src/wifi_analyzer/app.py:982
#, python-brace-format
msgid ""
"Ch {channel} · {frequency} MHz{width}{active} · {dbm} dBm · {security} · "
"{bssid}"
msgstr ""
"Kanal {channel} · {frequency} MHz{width}{active} · {dbm} dBm · {security} · "
"{bssid}"

#: src/wifi_analyzer/app.py:984 src/wifi_analyzer/app.py:1127
#: src/wifi_analyzer/app.py:1354
msgid "Open"
msgstr "Öppet nätverk"

#: src/wifi_analyzer/app.py:1044 src/wifi_analyzer/app.py:1493
msgid "WiFi Analyzer"
msgstr "WiFi Analyzer"

#: src/wifi_analyzer/app.py:1054
msgid "Toggle theme"
msgstr "Byt tema"

#: src/wifi_analyzer/app.py:1059 src/wifi_analyzer/app.py:1411
msgid "Export CSV"
msgstr "Exportera CSV"

#: src/wifi_analyzer/app.py:1060 src/wifi_analyzer/app.py:1418
msgid "Export JSON"
msgstr "Exportera JSON"

#: src/wifi_analyzer/app.py:1061 src/wifi_analyzer/app.py:1421
#: src/wifi_analyzer/app.py:1435
msgid "Export anonymized JSON"
msgstr "Exportera anonymiserad JSON"

#: src/wifi_analyzer/app.py:1062 src/wifi_analyzer/app.py:1449
msgid "Export diagnostic report"
msgstr "Exportera diagnostikrapport"

#: src/wifi_analyzer/app.py:1444
msgid "Export network details?"
msgstr "Exportera nätverksuppgifter?"

#: src/wifi_analyzer/app.py:1445
msgid "This export includes visible network names (SSIDs) and access point MAC addresses (BSSIDs). Save it locally and review it before sharing; these details can reveal nearby networks and your location."
msgstr "Exporten innehåller synliga nätverksnamn (SSID) och accesspunkternas MAC-adresser (BSSID). Spara den lokalt och granska den innan du delar den. Uppgifterna kan avslöja nätverk i närheten och din plats."

#: src/wifi_analyzer/app.py:1063 src/wifi_analyzer/app.py:1456
msgid "Connection diagnostics"
msgstr "Anslutningsdiagnostik"

#: src/wifi_analyzer/app.py:1064
msgid "Clear local history"
msgstr "Rensa lokal historik"

#: src/wifi_analyzer/app.py:1065
msgid "About"
msgstr "Om"

#: src/wifi_analyzer/app.py:1069
msgid "Scan"
msgstr "Skanna"

#: src/wifi_analyzer/app.py:1072
msgid "Monitor"
msgstr "Övervaka"

#: src/wifi_analyzer/app.py:1072
msgid "Scan every 60 seconds and notify about changes"
msgstr "Skanna var 60:e sekund och meddela när nätverken ändras"

#: src/wifi_analyzer/app.py:1107
msgid "Filter by name, BSSID, channel or security"
msgstr "Filtrera efter namn, BSSID, kanal eller säkerhetstyp"

#: src/wifi_analyzer/app.py:1116
msgid "Minimum signal"
msgstr "Minsta signalstyrka"

#: src/wifi_analyzer/app.py:1120
msgid "Only show access points at or above this estimated dBm value"
msgstr ""
"Visa bara åtkomstpunkter med minst den här uppskattade signalstyrkan (dBm)"

#: src/wifi_analyzer/app.py:1124 src/wifi_analyzer/app.py:1137
#: src/wifi_analyzer/app.py:1361
msgid "Security"
msgstr "Säkerhet"

#: src/wifi_analyzer/app.py:1127 src/wifi_analyzer/app.py:1353
msgid "All security"
msgstr "Alla säkerhetstyper"

#: src/wifi_analyzer/app.py:1132
msgid "Hidden SSIDs only"
msgstr "Endast dolda SSID:er"

#: src/wifi_analyzer/app.py:1136
msgid "Sort"
msgstr "Sortera"

#: src/wifi_analyzer/app.py:1137
msgid "Signal"
msgstr "Signal"

#: src/wifi_analyzer/app.py:1137 src/wifi_analyzer/app.py:1359
msgid "Channel"
msgstr "Kanal"

#: src/wifi_analyzer/app.py:1140
msgid "Profile"
msgstr "Profil"

#: src/wifi_analyzer/app.py:1142
msgid "Keep local scan history separate for this location"
msgstr "Spara separat skanningshistorik för den här profilen"

#: src/wifi_analyzer/app.py:1176
msgid "Ready — click Scan"
msgstr "Redo — välj Skanna"

#: src/wifi_analyzer/app.py:1220
#, python-brace-format
msgid "Main overlapping access points: {names}"
msgstr "Åtkomstpunkter med störst överlappning: {names}"

#: src/wifi_analyzer/app.py:1222
msgid "No overlapping access points detected"
msgstr "Inga överlappande åtkomstpunkter hittades"

#: src/wifi_analyzer/app.py:1233
#, python-brace-format
msgid "Local history for profile: {profile}"
msgstr "Lokal historik för profil: {profile}"

#: src/wifi_analyzer/app.py:1237
msgid "Recent measurements"
msgstr "Senaste mätningarna"

#: src/wifi_analyzer/app.py:1265
msgid "Scanning..."
msgstr "Skannar..."

#: src/wifi_analyzer/app.py:1281
msgid "Monitoring enabled; scanning every 60 seconds"
msgstr "Övervakning aktiverad; söker av var 60:e sekund"

#: src/wifi_analyzer/app.py:1285
msgid "Monitoring disabled"
msgstr "Övervakning inaktiverad"

#: src/wifi_analyzer/app.py:1311
#, python-brace-format
msgid " · {new} new, {gone} gone"
msgstr " · nya: {new}, försvunna: {gone}"

#: src/wifi_analyzer/app.py:1315
#, python-brace-format
msgid "Scan failed: {error}"
msgstr "Skanningen misslyckades: {error}"

#: src/wifi_analyzer/app.py:1317
#, python-brace-format
msgid "Found {count} networks{suffix}"
msgstr "Hittade {count} nätverk{suffix}"

#: src/wifi_analyzer/app.py:1321
msgid "Local scan history could not be saved"
msgstr "Den lokala skanningshistoriken kunde inte sparas"

#: src/wifi_analyzer/app.py:1324
msgid "WiFi scan changed"
msgstr "Wi-Fi-nätverken har ändrats"

#: src/wifi_analyzer/app.py:1325
#, python-brace-format
msgid "{new} new, {gone} gone, {changed} changed access points"
msgstr "{new} nya, {gone} försvunna, {changed} ändrade åtkomstpunkter"

#: src/wifi_analyzer/app.py:1388
msgid "Export"
msgstr "Exportera"

#: src/wifi_analyzer/app.py:1388 src/wifi_analyzer/app.py:1423
msgid "Cancel"
msgstr "Avbryt"

#: src/wifi_analyzer/app.py:1400
#, python-brace-format
msgid "Export failed: {error}"
msgstr "Exporten misslyckades: {error}"

#: src/wifi_analyzer/app.py:1410
#, python-brace-format
msgid "Exported CSV to {path}"
msgstr "CSV-filen exporterades till {path}"

#: src/wifi_analyzer/app.py:1417
#, python-brace-format
msgid "Exported JSON to {path}"
msgstr "JSON-filen exporterades till {path}"

#: src/wifi_analyzer/app.py:1422
msgid ""
"This export hides network names (SSIDs), access point MAC addresses (BSSIDs) "
"and connection-specific details. It keeps band, frequency, channel, signal, "
"width and security or regulatory details. Those details may still identify a "
"location, so review the file before sharing it."
msgstr ""
"Den här exporten döljer nätverksnamn (SSID), åtkomstpunkternas MAC-adresser "
"(BSSID) och anslutningsspecifika uppgifter. Band, frekvens, kanal, "
"signalstyrka, kanalbredd och säkerhets- eller regelverksinformation finns "
"kvar. Uppgifterna kan ändå avslöja var du befinner dig. Granska filen innan "
"du delar den."

#: src/wifi_analyzer/app.py:1424
msgid "Continue to export"
msgstr "Fortsätt exportera"

#: src/wifi_analyzer/app.py:1431
#, python-brace-format
msgid "Exported anonymized JSON to {path}"
msgstr "Den anonymiserade JSON-filen exporterades till {path}"

#: src/wifi_analyzer/app.py:1448
#, python-brace-format
msgid "Exported diagnostic report to {path}"
msgstr "Diagnostikrapporten exporterades till {path}"

#: src/wifi_analyzer/app.py:1453 src/wifi_analyzer/app.py:1454
#: src/wifi_analyzer/app.py:1455 src/wifi_analyzer/app.py:1458
msgid "unavailable"
msgstr "inte tillgänglig"

#: src/wifi_analyzer/app.py:1457
#, python-brace-format
msgid ""
"Gateway: {gateway}\n"
"DNS: {dns}\n"
"IP addresses: {addresses}\n"
"Link rate: {rates}"
msgstr ""
"Gateway: {gateway}\n"
"DNS: {dns}\n"
"IP-adresser: {addresses}\n"
"Länkhastighet: {rates}"

#: src/wifi_analyzer/app.py:1459
msgid "Close"
msgstr "Stäng"

#: src/wifi_analyzer/app.py:1464
msgid "Cleared local scan history"
msgstr "Den lokala skanningshistoriken har rensats"

#: src/wifi_analyzer/app.py:1466
msgid "Could not clear local scan history"
msgstr "Det gick inte att rensa den lokala skanningshistoriken"

#: src/wifi_analyzer/app.py:1480
msgid "WiFi Network Analysis Tool"
msgstr "Verktyg för analys av Wi-Fi-nätverk"

#: src/wifi_analyzer/app.py:1482
msgid "Created by"
msgstr "Skapad av"

#: src/wifi_analyzer/app.py:1483
msgid "With thanks to"
msgstr "Med tack till"

#: src/wifi_analyzer/app.py:1486
msgid "Project on GitHub"
msgstr "Projekt på GitHub"

#: src/wifi_analyzer/app.py:1518
msgid "Welcome"
msgstr "Välkommen"

#: src/wifi_analyzer/app.py:1523
msgid "Welcome to WiFi Analyzer"
msgstr "Välkommen till WiFi Analyzer"

#: src/wifi_analyzer/app.py:1524
msgid ""
"Analyze WiFi networks.\n"
"\n"
"✓ Scan nearby networks\n"
"✓ Signal strength monitoring\n"
"✓ Channel overlap detection"
msgstr ""
"Analysera Wi-Fi-nätverk.\n"
"\n"
"✓ Skanna nätverk i närheten\n"
"✓ Övervakning av signalstyrka\n"
"✓ Upptäck kanalöverlappning"

#: src/wifi_analyzer/app.py:1525
msgid "Get Started"
msgstr "Kom igång"

