msgstr "Exportera anonymiserad JSON"

#: src/wifi_analyzer/app.py:1041 src/wifi_analyzer/app.py:1419
msgid "Export diagnostic report"
msgstr "Exportera diagnostikrapport"

#: src/wifi_analyzer/app.py:1042 src/wifi_analyzer/app.py:1426
