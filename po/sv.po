#: src/wifi_analyzer/app.py:173
msgid "Unavailable in the detected regulatory domain"
msgstr "Inte tillgänglig i den upptäckta regleringsdomänen"

#: src/wifi_analyzer/app.py:175
msgid "DFS — radar detection may interrupt this channel"
msgstr "DFS — radardetektering kan avbryta denna kanal"

#: src/wifi_analyzer/app.py:177
msgid "DFS — availability depends on local regulations"
msgstr "DFS — tillgängligheten beror på lokala regler"

#: src/wifi_analyzer/app.py:258 src/wifi_analyzer/app.py:400
msgid "No Wi-Fi device found"
msgstr "Ingen Wi-Fi-enhet hittades"

#: src/wifi_analyzer/app.py:259
msgid ""
"Enable Wi-Fi in system settings, disable airplane mode, and check the "
"adapter driver."
msgstr ""
"Aktivera Wi-Fi i systeminställningarna, stäng av flygplansläge och "
"kontrollera adapterns drivrutin."

#: src/wifi_analyzer/app.py:262
msgid "Wi-Fi signal is weak"
msgstr "Wi-Fi-signalen är svag"

#: src/wifi_analyzer/app.py:263
msgid ""
"Move closer to the access point, reduce obstructions, or select a less "
"congested channel."
msgstr ""
"Flytta närmare åtkomstpunkten, minska hinder eller välj en mindre belastad "
"kanal."

#: src/wifi_analyzer/app.py:266
msgid "Wi-Fi connection was lost"
msgstr "Wi-Fi-anslutningen bröts"

#: src/wifi_analyzer/app.py:267
msgid ""
"Check the access point, reconnect from system settings, and inspect the "
"gateway and DNS diagnostics."
msgstr ""
"Kontrollera åtkomstpunkten, återanslut i systeminställningarna och granska "
"gateway- och DNS-diagnostiken."

#: src/wifi_analyzer/app.py:269
msgid "Wi-Fi access point changed"
msgstr "Wi-Fi-åtkomstpunkten ändrades"

#: src/wifi_analyzer/app.py:270
msgid ""
"Roaming can be normal. If it causes interruptions, compare signal history "
"and access-point overlap."
msgstr ""
"Roaming kan vara normalt. Om det orsakar avbrott kan du jämföra "
"signalhistorik och åtkomstpunktsöverlappning."

#: src/wifi_analyzer/app.py:398
msgid "Error: no WiFi device found"
msgstr "Fel: ingen Wi-Fi-enhet hittades"

#: src/wifi_analyzer/app.py:439 src/wifi_analyzer/app.py:1012
#: src/wifi_analyzer/app.py:1099
msgid "<Hidden>"
msgstr "<Dold>"

#: src/wifi_analyzer/app.py:508
msgid ""
"Focus the chart and use the Left and Right Arrow keys to choose a channel. "
"Press Home or End to jump to the first or last channel. Press Enter or Space "
"to filter the network list. Scroll to zoom."
msgstr ""
"Fokusera diagrammet och använd vänster- och högerpiltangenterna för att "
"välja kanal. Tryck på Home eller End för att hoppa till den första eller "
"sista kanalen. Tryck på Retur eller blanksteg för att filtrera "
"nätverkslistan. Rulla för att zooma."

#: src/wifi_analyzer/app.py:511
msgid "Channel overlap chart"
msgstr "Diagram över kanalöverlappning"

#: src/wifi_analyzer/app.py:559
#, python-brace-format
msgid "Channel {channel}. Press Enter to filter the network list."
msgstr "Kanal {channel}. Tryck på Retur för att filtrera nätverkslistan."

#: src/wifi_analyzer/app.py:569
msgid "Channel filter cleared."
msgstr "Kanalfiltreringen är avstängd."

#: src/wifi_analyzer/app.py:571
#, python-brace-format
msgid "Filtering access points by channel {channel}."
msgstr "Filtrerar åtkomstpunkter på kanal {channel}."

#: src/wifi_analyzer/app.py:632
msgid "No networks found"
msgstr "Inga nätverk hittades"

#: src/wifi_analyzer/app.py:765
msgid "measured"
msgstr "uppmätt"

#: src/wifi_analyzer/app.py:765
msgid "estimated"
msgstr "uppskattad"

#: src/wifi_analyzer/app.py:768
msgid " · Connected"
msgstr " · Ansluten"

