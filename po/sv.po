msgid "unavailable"
msgstr "inte tillgänglig"

#: src/wifi_analyzer/app.py:912
#, python-brace-format
msgid "Gateway: {gateway} · DNS: {dns}"
msgstr "Gateway: {gateway} · DNS: {dns}"

#: src/wifi_analyzer/app.py:917
msgid "Cleared local scan history"
msgstr "Rensade lokal sökhistorik"

#: src/wifi_analyzer/app.py:931
msgid "WiFi Network Analysis Tool"
msgstr "Analysverktyg för WiFi-nätverk"

#: src/wifi_analyzer/app.py:933
msgid "Created by"
msgstr "Skapad av"

#: src/wifi_analyzer/app.py:934
