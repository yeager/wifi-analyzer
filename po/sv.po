msgstr "{new} nya, {gone} försvunna, {changed} ändrade åtkomstpunkter"

#: src/wifi_analyzer/app.py:1120
#, python-brace-format
msgid "Least congested channel: {channel} (overlap score {score})"
msgstr "Minst belastade kanal: {channel} (överlappningspoäng {score})"

#: src/wifi_analyzer/app.py:1123
