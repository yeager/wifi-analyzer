diff -U0 -ruN a/data/io.github.yeager.wifi-analyzer.desktop b/data/io.github.yeager.wifi-analyzer.desktop
--- a/data/io.github.yeager.wifi-analyzer.desktop	1970-01-01 01:00:00
+++ b/data/io.github.yeager.wifi-analyzer.desktop	2026-10-29 16:28:19
@@ -0,0 +1,10 @@
+[Desktop Entry]
+Name=WiFi Analyzer
+Comment=WiFi Network Analysis Tool
+Exec=wifi-analyzer
+Icon=io.github.yeager.wifi-analyzer
+Terminal=false
+Type=Application
+StartupWMClass=io.github.yeager.wifi-analyzer
+Categories=Network;GTK;
+Keywords=wifi;wireless;network;analyzer;channel;
diff -U0 -ruN a/data/io.github.yeager.wifi-analyzer.metainfo.xml b/data/io.github.yeager.wifi-analyzer.metainfo.xml
--- a/data/io.github.yeager.wifi-analyzer.metainfo.xml	1970-01-01 01:00:00
+++ b/data/io.github.yeager.wifi-analyzer.metainfo.xml	2026-10-29 16:28:19
@@ -0,0 +1,101 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<component type="desktop-application">
+  <id>io.github.yeager.wifi-analyzer</id>
+  <name>WiFi Analyzer</name>
+  <summary>Inspect nearby Wi-Fi networks and channels</summary>
+  <metadata_license>CC0-1.0</metadata_license>
+  <project_license>GPL-3.0-or-later</project_license>
+  <developer id="io.github.yeager">
+    <name>Daniel Nylander</name>
+  </developer>
+  <launchable type="desktop-id">io.github.yeager.wifi-analyzer.desktop</launchable>
+  <provides>
+    <binary>wifi-analyzer</binary>
+  </provides>
+  <description>
+    <p>WiFi Analyzer shows nearby wireless networks, their signal strength, channel and security mode.</p>
+  </description>
+  <screenshots>
+    <screenshot type="default">
+      <caption>Compare nearby Wi-Fi networks and channel overlap.</caption>
+      <image>https://raw.githubusercontent.com/yeager/wifi-analyzer/main/screenshots/main.png</image>
+    </screenshot>
+  </screenshots>
+  <url type="homepage">https://www.danielnylander.se</url>
+  <url type="bugtracker">https://github.com/yeager/wifi-analyzer/issues</url>
+  <content_rating type="oars-1.1"/>
+  <releases>
+    <release version="0.1.22" date="2026-10-29">
+      <description><p>Use the exact GitHub repository slug in the application ID.</p></description>
+    </release>
+    <release version="0.1.21" date="2026-10-29">
+      <description><p>Match the desktop application ID to the GitHub repository slug.</p></description>
+    </release>
+    <release version="0.1.20" date="2026-10-29">
+      <description><p>Add keyboard navigation and screen-reader support to the channel graph.</p></description>
+    </release>
+    <release version="0.1.19" date="2026-10-25">
+      <description><p>Prepare PyPI distribution and synchronize release metadata.</p></description>
+    </release>
+    <release version="0.1.18" date="2026-09-22">
+      <description><p>Fix direct launch with Python from the source directory.</p></description>
+    </release>
+    <release version="0.1.17" date="2026-09-21">
+      <description><p>Add zoom and guidance to the interactive channel view.</p></description>
+    </release>
+    <release version="0.1.16" date="2026-09-21">
+      <description><p>Add interactive channel filtering and expanded connection diagnostics.</p></description>
+    </release>
+    <release version="0.1.15" date="2026-09-21">
+      <description><p>Add a profile-scoped local signal history graph for selected access points.</p></description>
+    </release>
+    <release version="0.1.14" date="2026-09-21">
+      <description><p>Show the measured active-link Wi-Fi generation in the network list.</p></description>
+    </release>
+    <release version="0.1.13" date="2026-09-21">
+      <description>
+        <p>Fix channel detection, safe scan handling, filtered exports, package support, a Swedish manual, and active-link Wi-Fi generation identification.</p>
+      </description>
+    </release>
+    <release version="0.1.12" date="2026-09-21">
+      <description>
+        <p>Add a new WiFi Analyzer logo and desktop application icon.</p>
+      </description>
+    </release>
+    <release version="0.1.11" date="2026-09-21">
+      <description>
+        <p>Add a 20-language gettext translation framework and compile translations in Flatpak builds.</p>
+      </description>
+    </release>
+    <release version="0.1.10" date="2026-09-21">
+      <description>
+        <p>Add actionable system notifications for Wi-Fi connection problems.</p>
+      </description>
+    </release>
+    <release version="0.1.9" date="2026-09-21">
+      <description>
+        <p>Add interference explanations, connection diagnostics, profile history, and monitoring notifications.</p>
+      </description>
+    </release>
+    <release version="0.1.8" date="2026-09-21">
+      <description>
+        <p>Add location profiles and optional background scan monitoring with change notifications.</p>
+      </description>
+    </release>
+    <release version="0.1.7" date="2026-09-21">
+      <description>
+        <p>Add active-connection details, scan comparison, measured channel width, anonymized exports, and HTML diagnostic reports.</p>
+      </description>
+    </release>
+    <release version="0.1.6" date="2026-09-21">
+      <description>
+        <p>Add congestion recommendations, local scan history, CSV/JSON export, sorting, and access-point details.</p>
+      </description>
+    </release>
+    <release version="0.1.5" date="2026-09-21">
+      <description>
+        <p>Add filtering, 6 GHz support, channel-width guidance, and DFS/regulatory indications.</p>
+      </description>
+    </release>
+  </releases>
+</component>
