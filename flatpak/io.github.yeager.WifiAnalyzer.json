{
  "app-id": "io.github.yeager.WifiAnalyzer",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "wifi-analyzer",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--system-talk-name=org.freedesktop.NetworkManager"
  ],
  "modules": [
    {
      "name": "wifi-analyzer",
      "buildsystem": "simple",
      "build-commands": [
        "python3 scripts/compile_translations.py",
        "pip3 install --no-index --no-build-isolation --prefix=/app .",
        "for mo in locale/*/LC_MESSAGES/wifi-analyzer.mo; do lang=$(basename $(dirname $(dirname $mo))); install -Dm644 $mo /app/share/locale/$lang/LC_MESSAGES/wifi-analyzer.mo; done",
        "install -Dm644 data/io.github.yeager.WifiAnalyzer.desktop /app/share/applications/io.github.yeager.WifiAnalyzer.desktop",
        "install -Dm644 data/icons/hicolor/512x512/apps/io.github.yeager.WifiAnalyzer.png /app/share/icons/hicolor/512x512/apps/io.github.yeager.WifiAnalyzer.png",
        "install -Dm644 data/icons/hicolor/256x256/apps/io.github.yeager.WifiAnalyzer.png /app/share/icons/hicolor/256x256/apps/io.github.yeager.WifiAnalyzer.png",
        "install -Dm644 data/io.github.yeager.WifiAnalyzer.metainfo.xml /app/share/metainfo/io.github.yeager.WifiAnalyzer.metainfo.xml"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/yeager/wifi-analyzer.git",
          "tag": "v0.1.12",
          "commit": "a81d4c5dbb483fb137a6f66f25aa9961ff3d6fea"
        }
      ]
    }
  ]
}
